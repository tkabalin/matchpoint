# Build context for apps/web/Dockerfile (the API builds from apps/api with its
# own .dockerignore). Everything the web build doesn't need stays out of the
# context so builds are fast and cache-stable.
.git/
**/node_modules/
**/dist/
**/dev-dist/
**/coverage/
apps/api/
deliverables/
docs/
infra/cloudflare/
# CI `docker save`s the built images to the repo root, so a leftover tarball sits
# next to the files this context does need.
*.tar
*.tar.gz
