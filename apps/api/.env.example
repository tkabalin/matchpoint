# Copy to .env and adjust if you need to override a default.
# The default already matches docker-compose.yml, so this is optional for local dev.
MATCHPOINT_DATABASE_URL=postgresql+psycopg://matchpoint:matchpoint@localhost:5432/matchpoint

# Uncomment when developing in Safari, which does not treat http://localhost as a secure
# context: it drops the Secure session cookie, so login appears to work and every request
# after it is a 401. Chrome and Firefox need nothing here.
# MATCHPOINT_SESSION_COOKIE_SECURE=false
