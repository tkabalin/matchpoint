# Copy to .env and adjust if you need to override a default.
# The default already matches docker-compose.yml, so this is optional for local dev.
MATCHPOINT_DATABASE_URL=postgresql+psycopg://matchpoint:matchpoint@localhost:5432/matchpoint

# Uncomment ONLY to check a real send by hand: these deliver actual email and spend the
# production account's quota, so post to a real inbox or a Resend simulator address
# (delivered@resend.dev) — Resend answers 422 to @example.com, which reads like a bad key.
# Comment them back out when you're done; the default writes the code to the log, where
# local dev reads it. pytest is unaffected either way: tests/__init__.py pins the logging
# sender for the whole run, so the suite cannot send real mail however this file is set.
# MATCHPOINT_EMAIL_SENDER=resend
# MATCHPOINT_RESEND_API_KEY=re_...

# Uncomment when developing in Safari, which does not treat http://localhost as a secure
# context: it drops the Secure session cookie, so login appears to work and every request
# after it is a 401. Chrome and Firefox need nothing here.
# MATCHPOINT_SESSION_COOKIE_SECURE=false
