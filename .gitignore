# -----------------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Node / pnpm / Vite / TypeScript (apps/web)
# -----------------------------------------------------------------------------
node_modules/
dist/
dev-dist/
.vite/

# ESLint / TypeScript / pnpm caches and logs
.eslintcache
*.tsbuildinfo
.pnpm-store/
pnpm-debug.log*

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
# What the API the suite runs against would have emailed, and the session the signed-up
# coach earned (scripts/e2e-api.sh, apps/web/e2e/auth.setup.ts).
/apps/web/e2e/.mail.jsonl
/apps/web/e2e/.auth/

# -----------------------------------------------------------------------------
# Python / uv / FastAPI (apps/api)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/
.pytest_cache/
# CI redirects these into the project so they can be cached between jobs; they
# don't appear locally, where both tools use the usual per-user cache dirs.
.uv-cache/
.pyright-node/
# Uploaded photos on a dev box (config.py's media_root default). In production these
# live in a Docker volume, never in the tree.
apps/api/media/

# -----------------------------------------------------------------------------
# Test reports and coverage (Vitest, pytest)
# -----------------------------------------------------------------------------
coverage/
.coverage
htmlcov/
junit.xml
junit-e2e.xml

# -----------------------------------------------------------------------------
# Container image tarballs
# -----------------------------------------------------------------------------
# CI `docker save`s each image to the repo root before uploading it. Anchored,
# because only the copies at the root are build output.
/*.tar
/*.tar.gz

# -----------------------------------------------------------------------------
# Claude Code personal/local settings, not meant to be shared with the team
# -----------------------------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
.claude/rules/*.local.md

# -----------------------------------------------------------------------------
# Local scratch/planning docs, not for the shared, finished docs/ tree
# -----------------------------------------------------------------------------
docs/scratch/

# -----------------------------------------------------------------------------
# Editors / OS
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
NUL
*:Zone.Identifier

# -----------------------------------------------------------------------------
# Logs / misc
# -----------------------------------------------------------------------------
*.log
logs/
