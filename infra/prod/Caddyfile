# Baked into the web image (apps/web/Dockerfile). TLS terminates here with a
# Cloudflare Origin Certificate (Cloudflare SSL mode: Full (strict)) — no ACME,
# nothing to renew, nothing for the proxy to break. The cert pair is mounted
# from the host at deploy time, never baked into the image.
matchpoint.thomaskabalin.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# Caddy logs errors but not requests unless asked, which leaves no record
	# that a request ever arrived — the timeline an outage is reconstructed from.
	# Output defaults to stderr, so Docker captures it and compose's log limits
	# bound it. Client IPs are Cloudflare's edge, not visitors': no trusted_proxies.
	#
	# Adding trusted_proxies to fix that is not a change to this file alone. Caddy
	# keeps a client's own X-Forwarded-For once the peer sending it is trusted, and
	# the api runs with --forwarded-allow-ips '*' (apps/api/Dockerfile), which takes
	# the leftmost entry of the chain — safe only while Caddy guarantees the chain is
	# the one address it saw. Trust Cloudflare here and the address the api keys its
	# sign-up rate limit on becomes whatever the visitor sent, i.e. a fresh bucket
	# per request. Change the two together, or not at all.
	log

	# HSTS is a property of the host, not of one response, so it sits at site level
	# and rides everything, API responses included. A year is safe: the domain lives
	# behind Cloudflare with TLS permanently on, so there is no plain-HTTP future to
	# get locked out of. No preload: that needs the registrable domain, which this
	# subdomain does not own. Policy rationale: docs/security.md.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# /api/* matches nothing for a bare /api, which would otherwise fall through
	# to the SPA and answer an API call with index.html and a 200.
	redir /api /api/ permanent

	# handle_path strips the /api prefix, so the API keeps clean route paths;
	# uvicorn runs with --root-path /api to compensate (see apps/api/Dockerfile).
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# SPA fallback: without try_files, refreshing any client-side route 404s.
	handle {
		root * /srv

		# The shell's security headers; API responses stamp their own set in
		# app middleware (headers.py), which is why none are set on the proxy
		# above. Everything the app loads is same-origin: Vite's bundles, the
		# service worker, /api calls. data: images stay allowed for artwork
		# CSS inlines. Policy rationale: docs/security.md.
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
		}

		# Vite fingerprints every filename it emits under /assets, so those URLs
		# never change content and can be cached for good. Everything else is the
		# app shell, which must be revalidated instead: a cached index.html keeps
		# booting the previous deploy's asset hashes, which are gone. no-cache
		# still allows a 304, so the cost is a conditional request, not a refetch.
		@fingerprinted path /assets/*
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
